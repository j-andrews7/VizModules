Package: vizModules
Title: Flexible, Interactive Shiny Modules for Almost Any Plot
Version: 0.99.0.9000
Authors@R: 
    c(person(given = "Jared", family = "Andrews", email = "jared.andrews07@gmail.com", role = c("aut", "cre"),
